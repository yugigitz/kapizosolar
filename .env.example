# Kapizo Solar — environment configuration
#
# Copy to `.env` and fill in real values. NEVER commit `.env` (it is gitignored).
#
# On Hostinger, place `.env` OUTSIDE public_html — one level above it — so it is
# never web-servable. The PHP endpoint looks for it two directories up from
# public_html/api/.
#
#   /home/uXXXXXXX/
#     .env              <-- here
#     storage/          <-- lead store, created automatically
#     public_html/
#       index.html
#       api/submit-lead.php


# ---------------------------------------------------------------------------
# Lead notification email (server-side only — never exposed to the browser)
# ---------------------------------------------------------------------------

# Where new enquiries are emailed. Comma-separated for multiple recipients.
LEAD_TO_EMAIL=connect@kapizosolar.in

# The From address, used as the `From:` header and the envelope sender.
#
# The endpoint sends with PHP's built-in mail(), NOT SMTP, so this is never a
# login and no password is involved anywhere. It only needs to be an address on
# your own domain: mail claiming to come from a domain you do not control gets
# rejected or filtered.
#
# Using the same mailbox for both values is deliberate and correct. A separate
# sending mailbox is not required, and creating one would consume a second
# mailbox slot for no benefit.
LEAD_FROM_EMAIL=connect@kapizosolar.in

# Prefix for the notification subject line.
LEAD_SUBJECT_PREFIX=[Kapizo Lead]


# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

# Absolute path to the append-only lead store (JSON Lines).
# Must be OUTSIDE public_html. Leave unset to use ../../storage/leads.jsonl
# relative to the api/ directory.
# LEAD_STORE_PATH=/home/uXXXXXXX/storage/leads.jsonl


# ---------------------------------------------------------------------------
# Abuse protection
# ---------------------------------------------------------------------------

# Maximum enquiries accepted from one IP per hour.
LEAD_RATE_LIMIT_PER_HOUR=20

# Origins allowed to POST to the endpoint (comma-separated).
LEAD_ALLOWED_ORIGINS=https://kapizosolar.in,https://www.kapizosolar.in


# ---------------------------------------------------------------------------
# Front-end build-time config (these ARE embedded in the JS bundle —
# put nothing secret here)
# ---------------------------------------------------------------------------

# Where the form posts. Defaults to /api/submit-lead.php when unset.
# Change only if you move the endpoint or use an external form service.
# VITE_LEAD_ENDPOINT=/api/submit-lead.php
