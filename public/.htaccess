# SPA routing for Apache / Hostinger shared hosting.
# Serves index.html for client-side routes so deep links work on refresh.

DirectoryIndex index.html

# Never serve environment files, the lead store, or version control data,
# even if one is accidentally uploaded into the web root.
<FilesMatch "^\.env|\.(jsonl|log|ini|sh|bak)$|^\.git">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # The lead intake endpoint is a real PHP file — let Apache handle it directly
  # so it is never swallowed by the SPA fallback below.
  RewriteRule ^api/ - [L]

  # Serve existing files as-is (assets, robots.txt, sitemap.xml, llms.txt).
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Serve the prerendered static HTML for a route when one exists.
  # The build writes dist/<route>/index.html for every known route, so
  # crawlers and link-preview scrapers get real content without running JS.
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ /$1/index.html [L]

  # Unknown routes fall back to the SPA shell, which renders the 404 page.
  RewriteRule . /index.html [L]
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Cache hashed build assets aggressively; keep HTML fresh.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
